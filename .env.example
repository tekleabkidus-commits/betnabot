APP_NAME=KemerBot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=
APP_DISPLAY_TIMEZONE=Africa/Addis_Ababa

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local Compose credentials below; replace for every shared deployment.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5445
DB_DATABASE=kemerbot
DB_USERNAME=kemerbot
DB_PASSWORD=kemerbot

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6381

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram secrets live in env only — never in DB, UI, logs, or audit metadata (spec §4.7)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_SEND_RATE=25

VITE_APP_NAME="${APP_NAME}"

# Channel ID/URL, Web App URL, test recipients, welcome content are DB settings (admin-editable).

# Production: use HTTPS, APP_ENV=production, APP_DEBUG=false, SESSION_SECURE_COOKIE=true.
# Queue visibility must exceed the 600-second campaign worker timeout.
REDIS_QUEUE_RETRY_AFTER=660
# External business events: independent random bearer secret, at least 32 characters.
CONVERSION_API_KEY=
# Explicit initial production Owner credentials (password at least 16 characters).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Multiple workers/hosts must share media: FILESYSTEM_DISK=s3 or a shared mounted local disk.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=
